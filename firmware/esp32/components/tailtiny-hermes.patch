     "src/ml_net_switch.c"
     "src/ml_config_httpd.c"
     "src/ml_json_strip.c"
 )
+endif()
 
 set(REQUIRES
     nvs_flash
@@ -28,8 +35,10 @@
     esp_timer
     lwip
     mbedtls
-    json
+    espressif__cjson
     driver
